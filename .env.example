# 이 파일만 GitHub에 올라간다. 실제 값은 .env 에 쓴다 (.env는 업로드되지 않음).
# 값 자리에는 설명만 쓰고, 실제 주소·키·계정은 절대 쓰지 않는다.
# 참고: 골목냥은 빌드 도구 없는 정적 사이트라 브라우저가 .env를 직접 읽지 못한다.
#       공개용 값(SUPABASE_URL, SUPABASE_ANON_KEY)은 M4에서 src/config.js 등에 넣는 방식을 정한다 (P-07).

APP_ENV=development

# Supabase (무료 등급). anon 키는 공개용이라 코드에 들어가도 된다.
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key

# 아래 관리자 키는 저장소·코드 어디에도 넣지 않는다. GitHub Actions에서 필요하면 저장소 Secrets에만 둔다.
# SUPABASE_SERVICE_ROLE_KEY=절대-커밋-금지

# 소셜 로그인 (Supabase 대시보드에 등록하는 값, 코드에는 넣지 않음)
KAKAO_REST_API_KEY=your-kakao-rest-api-key
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
